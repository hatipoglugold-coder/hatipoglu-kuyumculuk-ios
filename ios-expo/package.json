{
  "name": "hatipoglu-gold-ios",
  "version": "1.0.0",
  "description": "HATİPOĞLU KUYUMCULUK Apple iOS Mobil Uygulaması (Codemagic.io Destekli)",
  "main": "index.js",
  "scripts": {
    "start": "npx react-native start",
    "ios": "npx react-native run-ios",
    "build:codemagic": "codemagic-cli build",
    "prebuild:ios": "npx expo prebuild --platform ios",
    "pod:install": "cd ios && pod install",
    "web": "expo start --web",
    "postinstall": "node scripts/prepare-export-options.js"
  },
  "dependencies": {
    "expo": "~52.0.30",
    "expo-status-bar": "~2.0.1",
    "react": "18.3.1",
    "react-native": "0.76.6",
    "react-native-safe-area-context": "4.12.0",
    "expo-build-properties": "~0.13.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~18.3.12",
    "typescript": "^5.3.3"
  },
  "private": true
}